---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Resume" activePath="/resume">
  <Hero eyebrow="// resume" title="Bill — Software Engineer" lede="Shipping software for 20+ years. Games, web apps, tooling, and the occasional weird experiment." />

  <section class="container site-section">
    <div class="resume prose">
      <p class="resume__crumb"><a href="/">← Back home</a></p>

      <h2>About</h2>
      <ul>
        <li>GitHub: <a href="https://github.com/brenk28/" target="_blank" rel="noopener">github.com/brenk28</a></li>
        <li>LinkedIn: <a href="https://www.linkedin.com/in/bill-renk/" target="_blank" rel="noopener">linkedin.com/in/bill-renk</a></li>
        <li>Drupal: <a href="https://www.drupal.org/u/brenk28" target="_blank" rel="noopener">drupal.org/u/brenk28</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .site-section { margin-top: 2rem; }
  .resume { max-width: 720px; margin: 0 auto; }
  .resume__crumb { font-family: var(--font-display); margin-bottom: 1.5rem; }
</style>
